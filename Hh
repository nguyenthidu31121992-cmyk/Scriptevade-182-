local lastTick = tick()
local frameCount = 0
local fps = 60

local function getBubbles()
	local bubblesList = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "bubble") or string.find(string.lower(obj.Name), "bong")) then
			table.insert(bubblesList, obj)
		end
	end
	return bubblesList
end

-- Vòng lặp chính xử lý tính năng (ESP Players, ESP Bubbles khắc phục lỗi mất hiển thị, Auto Jump, Auto Collect, AFK Farm)
RunService.RenderStepped:Connect(function()
	frameCount += 1
	if tick() - lastTick >= 1 then
		fps = frameCount
		frameCount = 0
		lastTick = tick()
	end
	
	local pingVal = 0
	pcall(function()
		local network = game:GetService("Stats").Network
		if network then
			local statsItem = network:FindFirstChild("ServerStatsItem")
			if statsItem then
				local pingItem = statsItem:FindFirstChild("Data Ping")
				if pingItem then
					pingVal = math.floor(pingItem:GetValue())
				end
			end
		end
	end)
	
	statsLabel.Text = string.format("FPS: %d | Ping: %dms\nPlayers: %d", fps, pingVal, #Players:GetPlayers())
	
	-- Cập nhật kích thước nút nhảy theo cài đặt người dùng
	jumpFloatingBtn.Size = UDim2.new(0, settings.JumpButtonWidth, 0, settings.JumpButtonHeight)
	
	-- Chỉ hiện nút nhảy khi bật Auto Jump và menu đang ẩn
	jumpFloatingBtn.Visible = settings.MenuVisible == false and settings.AutoJumpEnabled

	-- ESP Players Logic
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local highlight = char:FindFirstChild("NewScriptV2_ESP_Player")
				if settings.EspPlayer then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "NewScriptV2_ESP_Player"
						highlight.Adornee = char
						highlight.FillColor = Color3.fromRGB(30, 130, 220)
						highlight.OutlineColor = Color3.fromRGB(240, 240, 240)
						highlight.Parent = char
					end
				else
					if highlight then highlight:Destroy() end
				end
			end
		end
	end

	-- ESP Bubbles Logic (Đã fix lỗi không nhận diện và mất hiển thị)
	local currentBubbles = getBubbles()
	if settings.EspBubbles then
		for _, bubble in ipairs(currentBubbles) do
			local highlight = bubble:FindFirstChild("NewScriptV2_ESP_Bubble")
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "NewScriptV2_ESP_Bubble"
				highlight.Adornee = bubble
				highlight.FillColor = Color3.fromRGB(220, 80, 220)
				highlight.OutlineColor = Color3.fromRGB(240, 240, 240)
				highlight.Parent = bubble
			end
		end
	else
		for _, bubble in ipairs(currentBubbles) do
			local highlight = bubble:FindFirstChild("NewScriptV2_ESP_Bubble")
			if highlight then highlight:Destroy() end
		end
	end

	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	-- Auto Jump khi chạm đất
	if settings.AutoJumpEnabled and hum and hum.FloorMaterial ~= Enum.Material.Air then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	-- AFK Farm TP 1500m trung tâm map
	if settings.AfkFarmSky and root and hum then
		root.CFrame = CFrame.new(0, 1500, 0)
		hum.PlatformStand = true
	end

	-- Tự động nhặt Bubbles
	if settings.AutoCollectBubbles and root then
		for _, bubble in ipairs(currentBubbles) do
			if bubble and bubble:IsA("BasePart") then
				root.CFrame = bubble.CFrame
				task.wait(0.1)
			end
		end
	end
end)
