	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 210, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.ZIndex = 3
	label.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 44, 0, 22)
	btn.Position = UDim2.new(1, -54, 0.5, -11)
	btn.BackgroundColor3 = settings[stateVar] and Color3.fromRGB(40, 160, 90) or Color3.fromRGB(40, 40, 50)
	btn.Text = ""
	btn.ZIndex = 4
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
	
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 14, 0, 14)
	indicator.Position = settings[stateVar] and UDim2.new(1, -18, 0, 4) or UDim2.new(0, 4, 0, 4)
	indicator.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
	indicator.ZIndex = 5
	indicator.Parent = btn
	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	btn.MouseButton1Click:Connect(function()
		settings[stateVar] = not settings[stateVar]
		local val = settings[stateVar]
		if val then
			btn.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
			indicator.Position = UDim2.new(1, -18, 0, 4)
		else
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			indicator.Position = UDim2.new(0, 4, 0, 4)
		end
	end)
end

-- Ô nhập chỉnh kích thước nút nhảy
local function createSizeInput(posY, text, defaultVal, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -10, 0, 36)
	frame.Position = UDim2.new(0, 5, 0, posY)
	frame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
	frame.ZIndex = 3
	frame.Parent = scrollContainer
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 180, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.ZIndex = 3
	label.Parent = frame

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 70, 0, 24)
	box.Position = UDim2.new(1, -80, 0.5, -12)
	box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	box.Text = tostring(defaultVal)
	box.TextColor3 = Color3.fromRGB(230, 230, 230)
	box.TextSize = 10
	box.FontFace = Font.new("rbxasset://fonts/families/GothamMedium.json")
	box.ZIndex = 4
	box.Parent = frame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

	box.FocusLost:Connect(function()
		local num = tonumber(box.Text)
		if num and num > 30 and num < 300 then
			callback(num)
		else
			box.Text = tostring(defaultVal)
		end
	end)
end

