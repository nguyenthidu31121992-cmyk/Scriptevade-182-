local function createToggle(posY, text, stateVar)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -10, 0, 36)
	frame.Position = UDim2.new(0, 5, 0, posY)
	frame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
