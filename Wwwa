	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.ZIndex = 3
	label.Parent = frame

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 60, 0, 22)
	box.Position = UDim2.new(1, -70, 0.5, -11)
	box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	box.Text = tostring(defaultVal)
	box.TextColor3 = Color3.fromRGB(230, 230, 230)
	box.TextSize = 10
	box.FontFace = Font.new("rbxasset://fonts/families/GothamMedium.json")
	box.ZIndex = 4
	box.Parent = frame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

	box.FocusLost:Connect(function()
		local num = tonumber(box.Text)
		if num and num >= minVal and num <= maxVal then
			callback(num)
		else
			box.Text = tostring(defaultVal)
		end
	end)
end

