local function createToggle(parent, posY, text, stateVar)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -10, 0, 34)
	frame.Position = UDim2.new(0, 5, 0, posY)
	frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
	frame.Parent = parent
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 190, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(210, 210, 225)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 44, 0, 22)
	btn.Position = UDim2.new(1, -52, 0.5, -11)
	btn.BackgroundColor3 = settings[stateVar] and Color3.fromRGB(40, 180, 100) or Color3.fromRGB(45, 45, 55)
	btn.Text = ""
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
	
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 14, 0, 14)
	indicator.Position = settings[stateVar] and UDim2.new(1, -18, 0, 4) or UDim2.new(0, 4, 0, 4)
	indicator.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	indicator.Parent = btn
	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	btn.MouseButton1Click:Connect(function()
		settings[stateVar] = not settings[stateVar]
		local val = settings[stateVar]
		if val then
			btn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
			indicator.Position = UDim2.new(1, -18, 0, 4)
		else
			btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
			indicator.Position = UDim2.new(0, 4, 0, 4)
		end
		
		if stateVar == "UltraShaderEnabled" then
			applyPCShader(val)
		end
		if stateVar == "EspPlayersEnabled" and not val then
			updateEspPlayers()
		end
		if stateVar == "AutoJumpEnabled" then
			jumpFloatingBtn.Visible = val
			if not val then
				jumpFloatingBtn:SetAttribute("IsActive", false)
				jumpFloatingBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
				jumpFloatingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
				jumpFloatingBtn.Text = "AUTO JUMP: OFF"
			end
		end
	end)
end

