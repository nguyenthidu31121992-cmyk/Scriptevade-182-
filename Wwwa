			if pcBloom then pcBloom:Destroy(); pcBloom = nil end
			if pcSunRays then pcSunRays:Destroy(); pcSunRays = nil end
			if pcColorCorrection then pcColorCorrection:Destroy(); pcColorCorrection = nil end
			if pcDepthOfField then pcDepthOfField:Destroy(); pcDepthOfField = nil end
		end)
	end
end

-- Hệ thống Fix Lag Ngược Sharder (V1, V2, V3)
local function applyFixLag(mode: string)
	pcall(function()
		if mode == "Off" then
			Lighting.GlobalShadows = true
			for _, v in ipairs(workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Reflectance = 0
				elseif v:IsA("Decal") or v:IsA("Texture") then
					v.Transparency = 0
				end
			end
		elseif mode == "V1_Light" then
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			for _, v in ipairs(workspace:GetDescendants()) do
				if v:IsA("Decal") or v:IsA("Texture") then
					v.Transparency = 0.5
				end
			end
		elseif mode == "V2_Medium" then
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 5000
			for _, v in ipairs(workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Material = Enum.Material.SmoothPlastic
				elseif v:IsA("Decal") or v:IsA("Texture") then
					v.Transparency = 1
				end
			end
		elseif mode == "V3_Heavy" then
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 2000
			for _, v in ipairs(workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Material = Enum.Material.SmoothPlastic
					v.Reflectance = 0
					v.CastShadow = false
				elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") then
					v.Transparency = 1
				end
			end
		end
	end)
end

-- Hệ thống Nhạc Cá Nhân (Client Music ID)
local clientMusicSound: Sound? = nil
local function playClientMusic(id: number)
	if clientMusicSound then
		clientMusicSound:Stop()
		clientMusicSound:Destroy()
		clientMusicSound = nil
	end
	
	if id > 0 then
		clientMusicSound = Instance.new("Sound")
		clientMusicSound.Name = "NewScriptV47_ClientMusic"
		clientMusicSound.SoundId = "rbxassetid://" .. tostring(id)
		clientMusicSound.Volume = 2
		clientMusicSound.Looped = true
		clientMusicSound.Parent = SoundService
		clientMusicSound:Play()
	end
end

local function updateEspPlayers()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			if char then
				local highlight = char:FindFirstChild("NewScriptV47_ESP_Highlight")
				local billboard = char:FindFirstChild("NewScriptV47_ESP_NameTag")
				
				if settings.EspPlayersEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "NewScriptV47_ESP_Highlight"
						highlight.Adornee = char
						highlight.FillColor = Color3.fromRGB(0, 255, 128)
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.FillTransparency = 0.4
						highlight.OutlineTransparency = 0
						highlight.Parent = char
					end
					
					if not billboard then
						local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if head then
							billboard = Instance.new("BillboardGui")
