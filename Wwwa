-- NÚT AUTO JUMP NỔI
local jumpFloatingBtn = Instance.new("TextButton")
jumpFloatingBtn.Size = UDim2.new(0, 140, 0, 45)
jumpFloatingBtn.Position = UDim2.new(0.75, 0, 0.55, 0)
jumpFloatingBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
jumpFloatingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
jumpFloatingBtn.Text = "AUTO JUMP: OFF"
jumpFloatingBtn.TextSize = 10
jumpFloatingBtn.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
jumpFloatingBtn.Visible = false
jumpFloatingBtn.Parent = screenGui
Instance.new("UICorner", jumpFloatingBtn).CornerRadius = UDim.new(0, 8)
local jStroke = Instance.new("UIStroke", jumpFloatingBtn)
jStroke.Thickness = 1.5
jStroke.Color = Color3.fromRGB(100, 100, 120)
makeDraggable(jumpFloatingBtn)

jumpFloatingBtn.MouseButton1Click:Connect(function()
	local activeState = not jumpFloatingBtn:GetAttribute("IsActive")
	jumpFloatingBtn:SetAttribute("IsActive", activeState)
	if activeState then
		jumpFloatingBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
		jumpFloatingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		jumpFloatingBtn.Text = "AUTO JUMP: ON"
	else
		jumpFloatingBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
		jumpFloatingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		jumpFloatingBtn.Text = "AUTO JUMP: OFF"
	end
end)

-- NÚT LAG SWITCH NỔI
local lagSwitchFloatingBtn = Instance.new("TextButton")
lagSwitchFloatingBtn.Size = UDim2.new(0, 150, 0, 45)
lagSwitchFloatingBtn.Position = UDim2.new(0.5, -75, 0.75, 0)
lagSwitchFloatingBtn.BackgroundColor3 = Color3.fromRGB(180, 95, 20)
lagSwitchFloatingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
lagSwitchFloatingBtn.Text = "LAG SWITCH PRO"
lagSwitchFloatingBtn.TextSize = 10
lagSwitchFloatingBtn.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
lagSwitchFloatingBtn.Visible = false
lagSwitchFloatingBtn.Parent = screenGui
Instance.new("UICorner", lagSwitchFloatingBtn).CornerRadius = UDim.new(0, 8)
makeDraggable(lagSwitchFloatingBtn)

local isLaggingPro = false
lagSwitchFloatingBtn.MouseButton1Click:Connect(function()
	if not isLaggingPro then
		isLaggingPro = true
		lagSwitchFloatingBtn.BackgroundColor3 = Color3.fromRGB(110, 40, 10)
		lagSwitchFloatingBtn.Text = "FREEZING..."
		
		local duration = math.clamp(settings.LagSwitchSeconds, 0, 10)
		if duration > 0 then
			local endTime = tick() + duration
			while tick() < endTime do
				local startBlock = tick()
				while tick() - startBlock < 0.05 do
					math.sqrt(math.random(1, 9999999))
				end
				task.wait()
			end
		end
		
		lagSwitchFloatingBtn.BackgroundColor3 = Color3.fromRGB(180, 95, 20)
		lagSwitchFloatingBtn.Text = "LAG SWITCH PRO"
		isLaggingPro = false
	end
end)

local statsLabel = Instance.new("TextLabel")
statsLabel.Size = UDim2.new(0, 140, 0, 36)
statsLabel.Position = UDim2.new(1, -150, 0, 20)
statsLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
statsLabel.TextColor3 = Color3.fromRGB(255, 180, 200)
statsLabel.TextSize = 9
statsLabel.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
statsLabel.Parent = screenGui
Instance.new("UICorner", statsLabel).CornerRadius = UDim.new(0, 8)

local lastTick = tick()
local frameCount = 0
local fps = 60

local processedBubbles = {}
local lastBubbleCheck = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount += 1
	if tick() - lastTick >= 1 then
		fps = frameCount
        frameCount = 0
		lastTick = tick()
	end
	
	statsLabel.Text = string.format("FPS: %d\nPlayers: %d", fps, #Players:GetPlayers())
	
	jumpFloatingBtn.Visible = settings.AutoJumpEnabled
	lagSwitchFloatingBtn.Visible = settings.LagSwitchActive

	if settings.EspPlayersEnabled then
		updateEspPlayers()
	end

	if settings.MenuRgbEnabled or settings.RgbLedEnabled then
		local hue = (tick() % 4) / 4
		local rainbowColor = Color3.fromHSV(hue, 1, 1)
		
		if settings.MenuRgbEnabled then
			mStroke.Color = rainbowColor
			tStroke.Color = rainbowColor
		else
			mStroke.Color = Color3.fromRGB(60, 60, 85)
			tStroke.Color = Color3.fromRGB(255, 150, 180)
		end

		if settings.RgbLedEnabled then
			updateRgbLed()
		end
	else
		mStroke.Color = Color3.fromRGB(60, 60, 85)
		tStroke.Color = Color3.fromRGB(255, 150, 180)
		local char = player.Character
		if char then
			local highlight = char:FindFirstChild("NewScriptV47_RGB_LED")
			if highlight then highlight:Destroy() end
		end
	end

	-- Xử lý Nhạc Cá Nhân
	if settings.CustomMusicEnabled then
		if not clientMusicSound or not clientMusicSound.IsPlaying then
			if settings.CustomMusicId > 0 then
				playClientMusic(settings.CustomMusicId)
			end
		end
	else
		if clientMusicSound then
			clientMusicSound:Stop()
			clientMusicSound:Destroy()
			clientMusicSound = nil
		end
	end

	-- Afk Farm Sky
	if settings.AfkFarmSky then
		updateAfkPlatform(true)
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				root.CFrame = CFrame.new(root.Position.X, 1500, root.Position.Z)
				root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
		end
	else
		updateAfkPlatform(false)
		
		-- Smart Teleport tới Bubbles mới
		if settings.AutoCollectBubbles and (tick() - lastBubbleCheck >= 0.8) then
			lastBubbleCheck = tick()
			task.spawn(function()
				local c = player.Character
				if c then
					local r = c:FindFirstChild("HumanoidRootPart")
					if r then
						for _, obj in ipairs(workspace:GetDescendants()) do
							if obj:IsA("BasePart") then
								local nLower = string.lower(obj.Name)
								if string.find(nLower, "bubble") or string.find(nLower, "bong") or string.find(nLower, "item") or string.find(nLower, "pickup") or string.find(nLower, "coin") then
									if not processedBubbles[obj] then
										processedBubbles[obj] = true
										r.CFrame = obj.CFrame + Vector3.new(0, 2, 0)
										r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
										break
									end
								end
							end
						end
					end
				end
			end)
		end
	end

	-- Auto Jump logic
	local char = player.Character
	if char and not settings.AfkFarmSky then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if settings.AutoJumpEnabled and (jumpFloatingBtn:GetAttribute("IsActive") == true) then
				if humanoid.FloorMaterial ~= Enum.Material.Air and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end
end)
