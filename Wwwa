			btn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
			indicator.Position = UDim2.new(1, -18, 0, 4)
		else
			btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
			indicator.Position = UDim2.new(0, 4, 0, 4)
		end
		
		if stateVar == "UltraShaderEnabled" then
			applyPCShader(val)
		end
		if stateVar == "FixLagEnabled" then
			applyFixLag(val)
		end
		if stateVar == "EspPlayersEnabled" and not val then
			updateEspPlayers()
		end
		if stateVar == "AutoJumpEnabled" then
			jumpFloatingBtn.Visible = val
			if not val then
				jumpFloatingBtn:SetAttribute("IsActive", false)
				jumpFloatingBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
				jumpFloatingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
				jumpFloatingBtn.Text = "AUTO JUMP: OFF"
			end
		end
	end)
end

