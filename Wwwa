local lastTick = tick()
local frameCount = 0
local fps = 60

local function getBubbles()
	local bubblesList = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "bubble") or string.find(string.lower(obj.Name), "bong")) then
			table.insert(bubblesList, obj)
		end
	end
	return bubblesList
end

RunService.RenderStepped:Connect(function()
	frameCount += 1
	if tick() - lastTick >= 1 then
		fps = frameCount
		frameCount = 0
		lastTick = tick()
	end
	
	local pingVal = 0
	pcall(function()
		local network = game:GetService("Stats").Network
		if network then
			local statsItem = network:FindFirstChild("ServerStatsItem")
			if statsItem then
				local pingItem = statsItem:FindFirstChild("Data Ping")
				if pingItem then
					pingVal = math.floor(pingItem:GetValue())
				end
			end
		end
	end)
	
	statsLabel.Text = string.format("FPS: %d | Ping: %dms\nPlayers: %d", fps, pingVal, #Players:GetPlayers())
	
	jumpFloatingBtn.Size = UDim2.new(0, settings.JumpButtonWidth, 0, settings.JumpButtonHeight)
	jumpFloatingBtn.Visible = settings.MenuVisible == false and settings.AutoJumpEnabled
	lagSwitchFloatingBtn.Visible = settings.MenuVisible == false and settings.LagSwitchButtonActive

	-- Hiệu ứng đổi màu RGB cho Menu và LED nhân vật
	if settings.MenuRgbEnabled or settings.RgbLedEnabled then
		local hue = (tick() % 4) / 4
		local rainbowColor = Color3.fromHSV(hue, 1, 1)
		
		if settings.MenuRgbEnabled then
			mStroke.Color = rainbowColor
			tStroke.Color = rainbowColor
			toggleBtn.TextColor3 = rainbowColor
		else
			mStroke.Color = Color3.fromRGB(50, 50, 65)
			tStroke.Color = Color3.fromRGB(70, 70, 95)
			toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
		end

		if settings.RgbLedEnabled then
			updateRgbLed()
		end
	else
		mStroke.Color = Color3.fromRGB(50, 50, 65)
		tStroke.Color = Color3.fromRGB(70, 70, 95)
		toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
		local char = player.Character
		if char then
			local highlight = char:FindFirstChild("NewScriptV2_RGB_LED")
			if highlight then highlight:Destroy() end
		end
	end

	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	local isJumpActive = jumpFloatingBtn:GetAttribute("IsActive") == true
	if settings.AutoJumpEnabled and isJumpActive and hum and hum.FloorMaterial ~= Enum.Material.Air then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	if settings.AfkFarmSky and root and hum then
		root.CFrame = CFrame.new(0, 1500, 0)
		hum.PlatformStand = true
		updateAfkPlatform(true)
	else
		updateAfkPlatform(false)
	end

	if settings.AutoCollectBubbles and root then
		local currentBubbles = getBubbles()
		for _, bubble in ipairs(currentBubbles) do
			if bubble and bubble:IsA("BasePart") then
				root.CFrame = bubble.CFrame
				task.wait(0.1)
			end
		end
	end
end)
