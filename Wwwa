-- Cơ chế Fix Lag Quét Theo Đợt (Batch Processing) Tránh Khựng Lag
local fixLagLoopThread = nil

local function applyFixLag(enable: boolean)
	if enable then
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9000
			for _, v in ipairs(Lighting:GetChildren()) do
				if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
					v.Enabled = false
				end
			end

			local function processBatch()
				local mode = settings.FixLagMode
				local descendants = Workspace:GetDescendants()
				local batchSize = 150 -- Xử lý mỗi đợt 150 vật thể rồi nhường frame cho game chạy mượt
				
				for i = 1, #descendants, batchSize do
					if not settings.FixLagEnabled then break end
					for j = i, math.min(i + batchSize - 1, #descendants) do
						local obj = descendants[j]
						if obj and obj.Parent then
							if mode == "Nhẹ (Giảm hiệu ứng)" then
								if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Beam") then
									obj.Enabled = false
								end
							elseif mode == "Trung bình (Xóa cỏ/lá)" then
								if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Beam") then
									obj.Enabled = false
								elseif obj:IsA("BasePart") then
									local name = string.lower(obj.Name)
									if string.find(name, "grass") or string.find(name, "leaf") or string.find(name, "plant") or string.find(name, "flower") or string.find(name, "bush") then
										obj:Destroy()
									end
								end
							elseif mode == "Cực hạn (Xóa toàn bộ Texture & Tài nguyên)" then
								if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Beam") or obj:IsA("Texture") or obj:IsA("Decal") then
									obj:Destroy()
								elseif obj:IsA("BasePart") then
									local name = string.lower(obj.Name)
									if string.find(name, "grass") or string.find(name, "leaf") or string.find(name, "plant") or string.find(name, "tree") or string.find(name, "prop") or string.find(name, "debris") then
										obj:Destroy()
									else
										obj.Material = Enum.Material.SmoothPlastic
										obj.Reflectance = 0
									end
								end
							end
						end
					end
					task.wait() -- Nghỉ 1 nhịp giữa các đợt để không bao giờ bị đứng hình
				end
			end

			-- Chạy đợt quét đầu tiên
			task.spawn(processBatch)

			-- Định kỳ cứ mỗi 10 giây sẽ quét lại theo đợt để dọn dẹp map mới nạp
			if not fixLagLoopThread then
				fixLagLoopThread = task.spawn(function()
					while true do
						task.wait(10)
						if not settings.FixLagEnabled then break end
						processBatch()
					end
				end)
			end
		end)
	else
		pcall(function()
			if fixLagLoopThread then
				task.cancel(fixLagLoopThread)
				fixLagLoopThread = nil
			end
			Lighting.GlobalShadows = true
			for _, v in ipairs(Lighting:GetChildren()) do
				if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
					v.Enabled = true
				end
			end
		end)
	end
end

local function updateEspPlayers()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			if char then
				local highlight = char:FindFirstChild("GummiHub_ESP_Highlight")
				local billboard = char:FindFirstChild("GummiHub_ESP_NameTag")
				
				if settings.EspPlayersEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "GummiHub_ESP_Highlight"
						highlight.Adornee = char
						highlight.FillColor = Color3.fromRGB(0, 255, 128)
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.FillTransparency = 0.4
						highlight.OutlineTransparency = 0
						highlight.Parent = char
					end
					
					if not billboard then
						local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if head then
							billboard = Instance.new("BillboardGui")
							billboard.Name = "GummiHub_ESP_NameTag"
							billboard.Size = UDim2.new(0, 100, 0, 40)
							billboard.StudsOffset = Vector3.new(0, 2.5, 0)
							billboard.AlwaysOnTop = true
							billboard.Adornee = head
							
							local textLabel = Instance.new("TextLabel")
							textLabel.Size = UDim2.new(1, 0, 1, 0)
							textLabel.BackgroundTransparency = 1
							textLabel.Text = p.Name
							textLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
							textLabel.TextSize = 12
							textLabel.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
							textLabel.TextStrokeTransparency = 0.3
							textLabel.Parent = billboard
							
							billboard.Parent = char
						end
					end
				else
					if highlight then highlight:Destroy() end
					if billboard then billboard:Destroy() end
				end
			end
		end
	end
end

local function makeDraggable(guiObj: GuiObject)
	local dragging, dragStart, startPos
	guiObj.InputBegan:Connect(function(input)
		if settings.LockButtons then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObj.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if settings.LockButtons then 
			dragging = false
			return 
		end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			guiObj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

