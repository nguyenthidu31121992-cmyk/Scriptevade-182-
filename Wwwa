local afkPlatform: Part? = nil
local function updateAfkPlatform(create: boolean)
	if create then
		if not afkPlatform or not afkPlatform.Parent then
			afkPlatform = Instance.new("Part")
			afkPlatform.Name = "NewScriptV2_AFKPlatform"
			afkPlatform.Size = Vector3.new(10, 1, 10)
			afkPlatform.Anchored = true
			afkPlatform.CanCollide = true
			afkPlatform.Transparency = 0.3
			afkPlatform.Color = Color3.fromRGB(40, 40, 50)
			afkPlatform.Material = Enum.Material.SmoothPlastic
			afkPlatform.Parent = workspace
		end
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root and afkPlatform then
				afkPlatform.CFrame = root.CFrame - Vector3.new(0, 4, 0)
			end
		end
	else
		if afkPlatform then
			afkPlatform:Destroy()
			afkPlatform = nil
		end
	end
end

-- Hệ thống RGB LED đổi màu cầu vồng cho nhân vật
local function updateRgbLed()
	if settings.RgbLedEnabled then
		local char = player.Character
		if char then
			local hue = (tick() % 5) / 5
			local rainbowColor = Color3.fromHSV(hue, 1, 1)
			local highlight = char:FindFirstChild("NewScriptV2_RGB_LED")
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "NewScriptV2_RGB_LED"
				highlight.Adornee = char
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
				highlight.Parent = char
			end
			highlight.FillColor = rainbowColor
			highlight.OutlineColor = rainbowColor
		end
	else
		local char = player.Character
		if char then
			local highlight = char:FindFirstChild("NewScriptV2_RGB_LED")
			if highlight then highlight:Destroy() end
		end
	end
end

-- Tính năng Fix Lag tăng cường FPS (Tối ưu hóa Lighting & Workspace)
local function applyAntiLag(enable: boolean)
	if enable then
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			for _, v in ipairs(workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Material = Enum.Material.SmoothPlastic
					v.Reflectance = 0
				elseif v:IsA("Decal") or v:IsA("Texture") then
					v.Transparency = 1
				end
			end
		end)
	end
end

