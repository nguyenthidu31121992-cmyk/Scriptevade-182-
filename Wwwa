local function updateRgbLed()
	if settings.RgbLedEnabled then
		local char = player.Character
		if char then
			local hue = (tick() % 5) / 5
			local rainbowColor = Color3.fromHSV(hue, 1, 1)
			local highlight = char:FindFirstChild("NewScriptV47_RGB_LED")
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "NewScriptV47_RGB_LED"
				highlight.Adornee = char
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
				highlight.Parent = char
			end
			highlight.FillColor = rainbowColor
			highlight.OutlineColor = rainbowColor
		end
	else
		local char = player.Character
		if char then
			local highlight = char:FindFirstChild("NewScriptV47_RGB_LED")
			if highlight then highlight:Destroy() end
		end
	end
end

local function makeDraggable(guiObj: GuiObject)
	local dragging, dragStart, startPos
	guiObj.InputBegan:Connect(function(input)
		if settings.LockButtons then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObj.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if settings.LockButtons then 
			dragging = false
			return 
		end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			guiObj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

