local processedItems = {}
local lastItemCheck = 0

RunService.RenderStepped:Connect(function()
	lagSwitchFloatingBtn.Visible = settings.LagSwitchActive

	if settings.MenuRgbEnabled then
		local hue = (tick() % 4) / 4
		local rainbowColor = Color3.fromHSV(hue, 1, 1)
		mStroke.Color = rainbowColor
		tStroke.Color = rainbowColor
	else
		mStroke.Color = Color3.fromRGB(60, 60, 85)
		tStroke.Color = Color3.fromRGB(255, 150, 180)
	end

	if settings.EspPlayersEnabled then
		updateEspPlayers()
	end

	settings.FovEnabled = false

	if settings.AfkFarmSky then
		updateAfkPlatform(true)
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				root.CFrame = CFrame.new(root.Position.X, 1500, root.Position.Z)
				root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
		end
	else
		updateAfkPlatform(false)
		
		if settings.AutoCollectBubbles and (tick() - lastItemCheck >= 0.8) then
			lastItemCheck = tick()
			task.spawn(function()
				local c = player.Character
				if c then
					local r = c:FindFirstChild("HumanoidRootPart")
					if r then
						for _, obj in ipairs(Workspace:GetDescendants()) do
							if obj:IsA("BasePart") then
								local nLower = string.lower(obj.Name)
								if string.find(nLower, "downed") or string.find(nLower, "item") or string.find(nLower, "pickup") or string.find(nLower, "ticket") then
									if not processedItems[obj] then
                                        processedItems[obj] = true
										r.CFrame = obj.CFrame + Vector3.new(0, 2, 0)
										r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
										break
									end
								end
							end
						end
					end
				end
			end)
		end
	end

	local char = player.Character
	if char and not settings.AfkFarmSky then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local rootPart = char:FindFirstChild("HumanoidRootPart")
		if humanoid then
			if settings.AutoJumpEnabled and (jumpFloatingBtn:GetAttribute("IsActive") == true) then
				if humanoid.FloorMaterial ~= Enum.Material.Air and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
			
			if settings.SpeedBoostEnabled then
				local targetSpeed = 16 + (settings.SpeedLevel * 11)
				
				if settings.BypassSpeedEnabled then
					humanoid.WalkSpeed = targetSpeed
					if rootPart and humanoid.MoveDirection.Magnitude > 0 then
						local moveDir = humanoid.MoveDirection
						rootPart.AssemblyLinearVelocity = Vector3.new(moveDir.X * targetSpeed, rootPart.AssemblyLinearVelocity.Y, moveDir.Z * targetSpeed)
					end
				else
					humanoid.WalkSpeed = targetSpeed
				end
			else
				if not settings.BypassSpeedEnabled and humanoid.WalkSpeed > 16 and humanoid.WalkSpeed <= 130 then
					humanoid.WalkSpeed = 16
				end
			end
		end
	end
end)
