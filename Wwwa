local afkPlatform: Part? = nil
local function updateAfkPlatform(create: boolean)
	if create then
		if not afkPlatform or not afkPlatform.Parent then
			afkPlatform = Instance.new("Part")
			afkPlatform.Name = "GummiHub_AFKPlatform"
			afkPlatform.Size = Vector3.new(12, 1, 12)
			afkPlatform.Anchored = true
			afkPlatform.CanCollide = true
			afkPlatform.Transparency = 0.3
			afkPlatform.Color = Color3.fromRGB(45, 45, 60)
			afkPlatform.Parent = workspace
		end
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root and afkPlatform then
				afkPlatform.CFrame = root.CFrame - Vector3.new(0, 4, 0)
			end
		end
	else
		if afkPlatform then
			afkPlatform:Destroy()
			afkPlatform = nil
		end
	end
end

-- Hệ thống Shader PC
local pcAtmosphere: Atmosphere? = nil
local pcBloom: BloomEffect? = nil
local pcSunRays: SunRaysEffect? = nil
local pcColorCorrection: ColorCorrectionEffect? = nil
local pcDepthOfField: DepthOfFieldEffect? = nil

local function applyPCShader(enable: boolean)
	if enable then
		pcall(function()
			Lighting.GlobalShadows = true
			Lighting.Technology = Enum.Technology.Future
			Lighting.EnvironmentDiffuseScale = 1.5
			Lighting.EnvironmentSpecularScale = 1.5
			Lighting.OutdoorAmbient = Color3.fromRGB(70, 80, 100)
			Lighting.Ambient = Color3.fromRGB(30, 35, 45)
			Lighting.Brightness = 2.2
			Lighting.ClockTime = 14.5
			
			if not pcAtmosphere then
				pcAtmosphere = Instance.new("Atmosphere")
				pcAtmosphere.Name = "GummiHub_PCAtmosphere"
				pcAtmosphere.Density = 0.38
				pcAtmosphere.Offset = 0.15
				pcAtmosphere.Color = Color3.fromRGB(190, 210, 245)
				pcAtmosphere.Decay = Color3.fromRGB(60, 70, 100)
				pcAtmosphere.Glare = 0.6
				pcAtmosphere.Haze = 1.8
				pcAtmosphere.Parent = Lighting
			end
			
			if not pcBloom then
				pcBloom = Instance.new("BloomEffect")
				pcBloom.Name = "GummiHub_PCBloom"
				pcBloom.Intensity = 0.85
				pcBloom.Size = 40
				pcBloom.Threshold = 0.8
				pcBloom.Parent = Lighting
			end
			
			if not pcSunRays then
				pcSunRays = Instance.new("SunRaysEffect")
				pcSunRays.Name = "GummiHub_PCSunRays"
				pcSunRays.Intensity = 0.45
				pcSunRays.Spread = 1
				pcSunRays.Parent = Lighting
			end
			
			if not pcColorCorrection then
				pcColorCorrection = Instance.new("ColorCorrectionEffect")
				pcColorCorrection.Name = "GummiHub_PCColorCorrection"
				pcColorCorrection.Brightness = 0.05
				pcColorCorrection.Contrast = 0.25
				pcColorCorrection.Saturation = 0.35
				pcColorCorrection.TintColor = Color3.fromRGB(255, 248, 240)
				pcColorCorrection.Parent = Lighting
			end

			if not pcDepthOfField then
				pcDepthOfField = Instance.new("DepthOfFieldEffect")
				pcDepthOfField.Name = "GummiHub_PCDepthOfField"
				pcDepthOfField.FarIntensity = 0.2
				pcDepthOfField.FocusDistance = 40
				pcDepthOfField.InFocusRadius = 25
				pcDepthOfField.Parent = Lighting
			end
		end)
	else
		pcall(function()
			if pcAtmosphere then pcAtmosphere:Destroy(); pcAtmosphere = nil end
			if pcBloom then pcBloom:Destroy(); pcBloom = nil end
			if pcSunRays then pcSunRays:Destroy(); pcSunRays = nil end
			if pcColorCorrection then pcColorCorrection:Destroy(); pcColorCorrection = nil end
			if pcDepthOfField then pcDepthOfField:Destroy(); pcDepthOfField = nil end
		end)
	end
end

local function updateEspPlayers()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			if char then
				local highlight = char:FindFirstChild("GummiHub_ESP_Highlight")
				local billboard = char:FindFirstChild("GummiHub_ESP_NameTag")
				
				if settings.EspPlayersEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "GummiHub_ESP_Highlight"
						highlight.Adornee = char
						highlight.FillColor = Color3.fromRGB(0, 255, 128)
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.FillTransparency = 0.4
						highlight.OutlineTransparency = 0
						highlight.Parent = char
					end
					
					if not billboard then
						local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if head then
							billboard = Instance.new("BillboardGui")
							billboard.Name = "GummiHub_ESP_NameTag"
							billboard.Size = UDim2.new(0, 100, 0, 40)
							billboard.StudsOffset = Vector3.new(0, 2.5, 0)
							billboard.AlwaysOnTop = true
							billboard.Adornee = head
							
							local textLabel = Instance.new("TextLabel")
							textLabel.Size = UDim2.new(1, 0, 1, 0)
							textLabel.BackgroundTransparency = 1
							textLabel.Text = p.Name
							textLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
							textLabel.TextSize = 12
							textLabel.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
							textLabel.TextStrokeTransparency = 0.3
							textLabel.Parent = billboard
							
							billboard.Parent = char
						end
					end
				else
					if highlight then highlight:Destroy() end
					if billboard then billboard:Destroy() end
				end
			end
		end
	end
end

local function makeDraggable(guiObj: GuiObject)
	local dragging, dragStart, startPos
	guiObj.InputBegan:Connect(function(input)
		if settings.LockButtons then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObj.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if settings.LockButtons then 
			dragging = false
			return 
		end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			guiObj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

