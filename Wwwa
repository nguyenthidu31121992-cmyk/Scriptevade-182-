	end

	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	local isTrimpActive = trimpFloatingBtn:GetAttribute("IsActive") == true
	if settings.TrimpEnabled and isTrimpActive and root and hum then
		if hum.FloorMaterial == Enum.Material.Air then
			if not wasInAir then
				wasInAir = true
				maxFallHeight = root.Position.Y
			else
				if root.Position.Y > maxFallHeight then
					maxFallHeight = root.Position.Y
				end
			end
		else
			if wasInAir then
				local fallDistance = maxFallHeight - root.Position.Y
				if fallDistance > 5 and hum.MoveDirection.Magnitude > 0 then
					-- Phá vỡ giới hạn 55 mặc định của game: Ép thẳng vận tốc Velocity theo chỉ số người dùng nhập (Ví dụ: 100)
					local targetVel = settings.SpeedOverrideValue
					root.Velocity = Vector3.new(hum.MoveDirection.X * targetVel, math.clamp(targetVel * 0.8, 65, 120), hum.MoveDirection.Z * targetVel)
				end
				wasInAir = false
				maxFallHeight = root.Position.Y
			end
		end
		
		-- Ép liên tục gia tốc chuyển động ngang để bộ đếm chỉ số tốc độ vàng góc dưới bên trái nhận diện chính xác con số (100+)
		if hum.MoveDirection.Magnitude > 0 and hum.FloorMaterial ~= Enum.Material.Air then
			local currentV = root.Velocity
			root.Velocity = Vector3.new(hum.MoveDirection.X * settings.SpeedOverrideValue, currentV.Y, hum.MoveDirection.Z * settings.SpeedOverrideValue)
		end
	end

	local isJumpActive = jumpFloatingBtn:GetAttribute("IsActive") == true
	if settings.AutoJumpEnabled and isJumpActive and hum and hum.FloorMaterial ~= Enum.Material.Air then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	if settings.AfkFarmSky and root and hum then
		root.CFrame = CFrame.new(0, 1500, 0)
		hum.PlatformStand = true
		updateAfkPlatform(true)
	else
		updateAfkPlatform(false)
	end

	if settings.AutoCollectBubbles and root then
		for _, bubble in ipairs(getBubbles()) do
			if bubble and bubble:IsA("BasePart") then
				root.CFrame = bubble.CFrame
				task.wait(0.05)
			end
		end
	end
end)
