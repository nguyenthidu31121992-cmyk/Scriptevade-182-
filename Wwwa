	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 200, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(210, 210, 225)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.Parent = frame

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 65, 0, 24)
	box.Position = UDim2.new(1, -75, 0.5, -12)
	box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	box.Text = tostring(defaultVal)
	box.TextColor3 = Color3.fromRGB(240, 240, 240)
	box.TextSize = 10
	box.FontFace = Font.new("rbxasset://fonts/families/GothamMedium.json")
	box.Parent = frame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	box.FocusLost:Connect(function()
		local num = tonumber(box.Text)
		if num and num >= minVal and num <= maxVal then
			callback(num)
		else
			box.Text = tostring(defaultVal)
		end
	end)
end

