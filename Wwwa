		if val then
			btn.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
			indicator.Position = UDim2.new(1, -18, 0, 4)
		else
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
