local toggleActiveInput: InputObject? = nil
local toggleDragStart = Vector2.zero
local toggleStartPos = UDim2.new()
local toggleHasMoved = false

toggleBtn.InputBegan:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not toggleActiveInput then
		toggleActiveInput = input
		toggleDragStart = input.Position
		toggleStartPos = toggleBtn.Position
		toggleHasMoved = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == toggleActiveInput then
		local delta = input.Position - toggleDragStart
		if delta.Magnitude > 6 then
			toggleHasMoved = true
		end
		toggleBtn.Position = UDim2.new(toggleStartPos.X.Scale, toggleStartPos.X.Offset + delta.X, toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == toggleActiveInput then
		if not toggleHasMoved then
			settings.MenuVisible = not settings.MenuVisible
			mainFrame.Visible = settings.MenuVisible
		end
		toggleActiveInput = nil
	end
end)

