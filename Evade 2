local function createToggle(posY, text, stateVar)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -10, 0, 40)
	frame.Position = UDim2.new(0, 5, 0, posY)
	frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
	frame.ZIndex = 3
	frame.Parent = scrollContainer
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 200, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(240, 240, 240)
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.FontFace = Font.new("rbxasset://fonts/families/GothamBold.json")
	label.ZIndex = 3
	label.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 50, 0, 24)
	btn.Position = UDim2.new(1, -60, 0.5, -12)
	btn.BackgroundColor3 = settings[stateVar] and Color3.fromRGB(0, 220, 100) or Color3.fromRGB(45, 45, 55)
	btn.Text = ""
	btn.ZIndex = 4
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
	
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 16, 0, 16)
	indicator.Position = settings[stateVar] and UDim2.new(1, -20, 0, 4) or UDim2.new(0, 4, 0, 4)
	indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	indicator.ZIndex = 5
	indicator.Parent = btn
	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	btn.MouseButton1Click:Connect(function()
		settings[stateVar] = not settings[stateVar]
		local val = settings[stateVar]
		if val then
			btn.BackgroundColor3 = Color3.fromRGB(0, 220, 100)
			indicator.Position = UDim2.new(1, -20, 0, 4)
		else
			btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
			indicator.Position = UDim2.new(0, 4, 0, 4)
		end
	end)
end

